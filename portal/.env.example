# Portal-owned storage. Use a local filesystem with reliable SQLite locking.
PORTAL_DATABASE_PATH=/config/portal.db
PORTAL_PUBLIC_URL=https://media.example.com
PORTAL_COOKIE_SECURE=true

# Generate three unrelated values of at least 32 characters. Prefer *_FILE in
# deployments. Never commit populated values.
PORTAL_SECRET_KEY=
PORTAL_SECRET_KEY_FILE=
PORTAL_INTERNAL_ASSERTION_SECRET=
PORTAL_INTERNAL_ASSERTION_SECRET_FILE=
PORTAL_BOOTSTRAP_SECRET=
PORTAL_BOOTSTRAP_SECRET_FILE=
PORTAL_BOOTSTRAP_EXPIRES_SECONDS=3600

# local (default), oidc, or hybrid.
PORTAL_AUTH_MODE=local
PORTAL_SESSION_SECONDS=28800
PORTAL_LOGIN_MAX_ATTEMPTS=5
PORTAL_LOGIN_WINDOW_SECONDS=900
PORTAL_LOGIN_LOCK_SECONDS=900

# Enabled modules only. Module URLs are internal service URLs; navigation paths
# are same-origin paths presented to the browser.
PORTAL_MODULES_JSON=[]
PORTAL_MODULE_TIMEOUT_SECONDS=1.5

# Optional OIDC/Authentik. Required only for oidc or hybrid mode.
PORTAL_OIDC_ISSUER=
PORTAL_OIDC_CLIENT_ID=
PORTAL_OIDC_CLIENT_SECRET=
PORTAL_OIDC_CLIENT_SECRET_FILE=
PORTAL_OIDC_REDIRECT_URI=
PORTAL_OIDC_SCOPES=openid profile email
PORTAL_OIDC_ALLOWED_GROUPS=
PORTAL_OIDC_ADMIN_GROUPS=
PORTAL_OIDC_LOGOUT=local

PORTAL_INTERNAL_ASSERTION_ISSUER=foxden-portal
PORTAL_INTERNAL_ASSERTION_SECONDS=60
